pipeline {
    agent any

    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }

            steps {
                sh '''
                    echo "===== Workspace ====="
                    ls -la

                    echo "===== Node Version ====="
                    node --version

                    echo "===== NPM Version ====="
                    npm --version

                    echo "===== Installing Dependencies ====="
                    npm ci

                    echo "===== Building Application ====="
                    npm run build

                    echo "===== Workspace After Build ====="
                    ls -la
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Test Stage'
            }
        }
    }
}
